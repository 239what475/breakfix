# Copy to a local file outside Git and create the runtime Secret from it.
# URL-encode the database password in the DSN.
postgres_password=replace-with-postgres-password
database_url=postgres://breakfix:replace-with-postgres-password@breakfix-postgresql:5432/breakfix?sslmode=disable
jwt_secret=replace-with-a-long-random-jwt-secret
deepseek_api_key=replace-with-deepseek-api-key
opensandbox_api_key=replace-with-opensandbox-lifecycle-api-key
ui_origin=https://breakfix.example.com
registry_addr=registry.breakfix.internal/breakfix
registry_pull_secret=breakfix-registry-pull
# Leave empty when the Registry presents a certificate trusted by the normal
# system trust store. Set this to the mounted ConfigMap path for an internal CA.
registry_trust_bundle_file=/var/run/config/breakfix-registry-ca/ca.crt
registry_username=replace-with-registry-username
registry_password=replace-with-registry-password
incus_endpoint=https://incus.internal.example:8443
incus_base_image_fingerprint=replace-with-full-lowercase-sha256-fingerprint
k8s_base_image_digest=registry.breakfix.internal/breakfix/k8s-base@sha256:replace-with-full-lowercase-sha256-digest

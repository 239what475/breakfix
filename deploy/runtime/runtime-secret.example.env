# Copy to a local file outside Git and create the runtime Secret from it.
# URL-encode database passwords in both DSNs.
postgres_password=replace-with-postgres-password
agent_database_password=replace-with-agent-role-password
database_url=postgres://breakfix:replace-with-postgres-password@breakfix-postgresql:5432/breakfix?sslmode=disable
agent_database_url=postgres://breakfix_agent:replace-with-agent-role-password@breakfix-postgresql:5432/breakfix?sslmode=disable
jwt_secret=replace-with-a-long-random-jwt-secret
internal_api_key=replace-with-a-long-random-internal-key
deepseek_api_key=replace-with-deepseek-api-key
registry_addr=registry.example.com/breakfix
registry_insecure=false

{
  "name": "breakfix-e2e",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:headed": "playwright test -c playwright.config.ts --headed",
    "test:e2e:debug": "playwright test -c playwright.config.ts --debug",
    "test:e2e:node": "playwright test -c playwright.node.config.ts",
    "test:e2e:k8s": "playwright test -c playwright.k8s.config.ts",
    "test:e2e:recovery": "playwright test -c playwright.recovery.config.ts",
    "test:e2e:playground": "playwright test -c playwright.playground.config.ts",
    "test:acceptance:node": "playwright test -c playwright.agent-live.config.ts authoring.node.live.spec.ts",
    "test:acceptance:mcp": "playwright test -c playwright.agent-live.config.ts authoring.mcp.live.spec.ts",
    "test:acceptance:interruption": "playwright test -c playwright.agent-live.config.ts authoring.interruption.live.spec.ts",
    "test:agent-live:assistant": "playwright test -c playwright.agent-live.config.ts assistant.live.spec.ts",
    "test:agent-live:soak": "playwright test -c playwright.agent-live.config.ts assistant.soak.live.spec.ts",
    "test:agent-live:k8s": "playwright test -c playwright.agent-live.config.ts authoring.k8s.live.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "yaml": "^2.9.1"
  }
}

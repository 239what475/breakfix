{
  "name": "breakfix-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-ts -i ../api/http/openapi.yaml -o src/api/generated -p @hey-api/typescript --no-log-file",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43"
  },
  "overrides": {
    "js-yaml": "5.4.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
